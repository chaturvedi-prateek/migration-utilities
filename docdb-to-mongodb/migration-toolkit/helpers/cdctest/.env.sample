# CDC throughput test kit (Adiom T0/T1/T2) — copy to .env and fill in.
#
# Stream-only tests (SKIP_INITIAL_SYNC is forced on by run-cdc-test.sh) that
# run in their OWN compose project "cdctest" with their own Temporal on host
# ports 17233 / 18233 and a dashboard on 8082, so they never touch the main
# flow. Run during peak source write traffic, one test at a time.
#
#   T0  current shared-stream config -> /dev/null      (dsynct-internal limit)
#   T1  current shared-stream config -> SCRATCH Atlas  (expected to fall behind)
#   T2  --per-namespace-streams      -> SCRATCH Atlas  (expected to keep up)

# Same source as the main flow (in-container CA path).
DOCDB_SRC=mongodb://dsync_migration:PASSWORD@your-cluster.cluster-xxxx.ap-south-1.docdb.amazonaws.com:27017/?tls=true&tlsCAFile=/certs/global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# A SCRATCH cluster/database for T1/T2 — NEVER the production destination.
# run-cdc-test.sh refuses to start when this host equals MDB_DEST in
# ../compose/.env (override that path with MAIN_ENV=/path/to/.env).
SCRATCH_MDB_DEST=mongodb+srv://scratch_user:PASSWORD@scratch.xxxxx.mongodb.net/?retryWrites=true

# Namespaces to stream — same value as the main flow's NAMESPACE (a db, a
# db.coll, or a comma-separated list).
NAMESPACE=your-db

# Worker knobs — keep equal to the main flow so the test measures that config.
# Every stream partition holds 2 activity slots (StreamChanges + StreamLSN),
# so for T2 CONCURRENT_ACTIVITIES x WORKER_COUNT must be >= 2 x collections.
WORKER_COUNT=3
CONCURRENT_ACTIVITIES=4
SYNC_WRITER_WORKERS=8
PER_STREAM_WORKERS=4
DOC_PARTITION=500000
NAMESPACE_FANOUT=100
DOCUMENTDB_SAMPLING_FANOUT=100
ATTEMPTS_BEFORE_PAUSE=3
